# انسخ هذا الملف باسم .env واكتب بياناتك الحقيقية فيه (لا ترفع .env على GitHub أبدًا)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/todo-store?retryWrites=true&w=majority
PORT=3000
# مفتاح سري لتوقيع تسجيل الدخول (JWT). ولّد واحد عشوائي بالأمر:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ضع_هنا_النص_العشوائي_الطويل

# ---- إرسال الإيميل (أكواد التفعيل ونسيت كلمة المرور) ----
# لو سبتها فاضية: الكود هيظهر في التيرمينال بدل ما يتبعت بإيميل (للتجربة بس)
# مع Gmail: فعّل التحقق بخطوتين ثم اعمل "App password" من حساب جوجل وحطه في SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=كلمة_مرور_التطبيق
MAIL_FROM="ToDo <your-email@gmail.com>"
